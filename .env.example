# Backend runtime configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"

# Optional: defaults to port 4000 and allows all origins.
PORT="4000"
CORS_ORIGIN="*"

# Frontend build configuration.
# Leave blank when frontend and backend share one deployment origin.
VITE_API_BASE_URL=""

# Optional AI integration key used by the application when enabled.
GEMINI_API_KEY=""
